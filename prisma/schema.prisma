generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  MAX
}

model User {
  id                   String         @id @default(cuid())
  email                String?        @unique
  name                 String?
  githubId             String?        @unique
  avatarUrl            String?
  plan                 Plan           @default(FREE)
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  /// sha256 of the key the macOS app sends as a Bearer token
  deviceKeyHash        String?        @unique
  /// PROFILE.md: lasting facts Zido has learned about the user
  profileMd            String         @default("")
  /// VOLATILE.md: short-lived recent context, trimmed automatically
  volatileMd           String         @default("")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  integrations         Integration[]
  conversations        Conversation[]
  agentTasks           AgentTask[]
}

/// Third-party tokens (GitHub, Vercel), encrypted with AES-256-GCM. Never stored in plain text.
model Integration {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  ciphertext String
  iv         String
  authTag    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  /// [RECT: x, y, w, h, label] highlights returned with an assistant message
  rects          Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentTask {
  id           String    @id @default(cuid())
  userId       String
  tool         String
  status       String    @default("pending")
  input        Json
  output       Json?
  secondsSaved Int       @default(0)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Processed Stripe webhook events, for idempotency
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
