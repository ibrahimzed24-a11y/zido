generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  MAX
}

model User {
  id                   String         @id @default(cuid())
  email                String?        @unique
  name                 String?
  githubId             String?        @unique
  githubLogin          String?
  avatarUrl            String?
  plan                 Plan           @default(MAX)
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  integrations         Integration[]
  devices              Device[]
  conversations        Conversation[]
  agentTasks           AgentTask[]
  activities           Activity[]
  memoryFiles          MemoryFile[]
  subscriptions        Subscription[]
}

/// Stripe subscriptions; User.plan mirrors the active one. Written only by the verified webhook.
model Subscription {
  /// Stripe subscription id (sub_...)
  id               String    @id
  userId           String
  plan             Plan
  status           String
  priceId          String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Third-party tokens (GitHub, Vercel), encrypted with AES-256-GCM. Never stored in plain text.
model Integration {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  ciphertext String
  iv         String
  authTag    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/// A Mac running the Zido app. The app sends its device key as a Bearer token; only the sha256 is stored.
model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("My Mac")
  keyHash    String    @unique
  platform   String    @default("macOS")
  appVersion String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The activity feed on the dashboard.
model Activity {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  summary   String
  meta      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Per-user memory files: PROFILE.md (lasting facts) and VOLATILE.md (recent context).
model MemoryFile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  /// Normalized [RECT: x, y, w, h, label] highlights (0-1 fractions) returned with an assistant message
  rects          Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentTask {
  id           String    @id @default(cuid())
  userId       String
  tool         String
  status       String    @default("pending")
  input        Json
  output       Json?
  secondsSaved Int       @default(0)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

/// Processed Stripe webhook events, for idempotency
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
