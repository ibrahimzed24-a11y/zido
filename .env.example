# PostgreSQL connection string (Neon, Supabase, RDS, local...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zido?sslmode=require"

# Public URL of this app, no trailing slash
APP_URL="http://localhost:3000"

# 32+ random characters used to sign session cookies: openssl rand -base64 48
SESSION_SECRET=""

# 64 hex characters (32 bytes) for AES-256-GCM encryption of Integration tokens: openssl rand -hex 32
ENCRYPTION_KEY=""

# Anthropic
ANTHROPIC_API_KEY=""
ZIDO_MODEL="claude-3-5-sonnet-20241022"

# GitHub OAuth App (callback: APP_URL/api/auth/github/callback)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe (subscription prices for Pro and Max)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_MAX=""
