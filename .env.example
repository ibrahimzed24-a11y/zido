# PostgreSQL connection string (Neon, Supabase, RDS, local...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zido?sslmode=require"
# Optional direct (unpooled) connection, used only to run migrations during the build
DATABASE_URL_UNPOOLED=""

# Public URL of this app, no trailing slash. Production: https://zido-gamma.vercel.app
APP_URL="http://localhost:3000"

# 32+ random characters used to sign session cookies: openssl rand -base64 48
SESSION_SECRET=""

# 64 hex characters (32 bytes) for AES-256-GCM encryption of Integration tokens: openssl rand -hex 32
ENCRYPTION_KEY=""

# Ollama (server-side only). Ollama Cloud needs OLLAMA_API_KEY from https://ollama.com/settings/keys
OLLAMA_HOST="https://ollama.com"
OLLAMA_API_KEY=""
OLLAMA_MODEL="gemma4:31b"

# Optional: a self-hosted Ollama server reachable from the web server, used by local_ai_fallback
OLLAMA_LOCAL_HOST=""
OLLAMA_LOCAL_MODEL="gemma4:31b"

# GitHub OAuth App (callback: APP_URL/api/auth/github/callback)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe (subscription prices for Pro and Max)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_MAX=""
